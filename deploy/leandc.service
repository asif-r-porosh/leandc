# Template. The README shows how to fill in the user and home (sed) and install it to /etc/systemd/system/leandc.service.
# Install leandc first (./install.sh) as that user.
[Unit]
Description=leandc MCP server
After=network-online.target
Wants=network-online.target

[Service]
User=youruser
WorkingDirectory=/home/youruser
Environment=LEANDC_CONFIG=/home/youruser/.config/leandc/config.toml
ExecStart=/home/youruser/.local/share/leandc/venv/bin/leandc serve
Restart=on-failure
RestartSec=3
# Do NOT set KillMode=process: leandc kills its own jobs on stop; stray children must not outlive the service.
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
