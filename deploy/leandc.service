# VM: /etc/systemd/system/leandc.service  (edit User and paths, then: systemctl daemon-reload; systemctl enable --now leandc)
[Unit]
Description=leandc MCP server
After=network-online.target
Wants=network-online.target

[Service]
User=asif
WorkingDirectory=/home/asif/apps/leandc
Environment=LEANDC_CONFIG=/home/asif/.config/leandc/config.toml
ExecStart=/home/asif/apps/leandc/.venv/bin/leandc serve
Restart=on-failure
RestartSec=3
# Do NOT set KillMode=process: leandc kills its own jobs on stop; stray children must not outlive the service.
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
